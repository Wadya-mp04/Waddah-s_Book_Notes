<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cutive+Mono&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="assets/favicon.png">
    <script type="text/javascript" src="script/script.js" defer></script>
    <title>Document</title>
</head>
<body>
    <div class="header">
        <button id="theme-switch" class="btn" onclick="themeClick()" > 
            <svg id="lightmode"  class="shake" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" ><path d="M480-280q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Z"/></svg>
            <svg id="darkmode" class="shake" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" ><path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Z"/></svg>
        </button>
        <h1 class="header-title">Waddah's Book Notes</h1>
        <a href="/" id="home-button" class="btn">
        <svg class="shake" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px">
            <path d="M240-200h120v-240h240v240h120v-360L480-740 240-560v360Zm-80 80v-480l320-240 320 240v480H520v-240h-80v240H160Zm320-350Z"/>
        </svg>
        </a>
    </div>
    <div class="page">
    <div class="creation_card">
        <div class="creation_grid">

        <!-- LEFT: form -->
        <form class="creation_form" autocomplete="off" method="post" action="/add">
            <div class="field">
            <label for="bookTitle">Title</label>
            <input id="bookTitle" name="title" type="text" placeholder="Auto-filled from ISBN" disabled>
            <input id="bookTitleHidden" name="title" type="hidden">
            <small class="hint">Title is fetched from ISBN.</small>
            </div>

            <div class="row">
            <div class="field">
                <label for="isbn">ISBN</label>
                <input id="isbn" name="isbn" type="text" inputmode="numeric" placeholder="e.g. 9780143127741">
                <small id="isbnStatus" class="hint"></small>
            </div>

            <div class="field">
                <label for="rating">Rating (1–10)</label>
                <input id="rating" name="rating" type="number" placeholder="Insert rating">
                <small id="ratingStatus" class="hint"></small>
            </div>
            </div>

            <div class="field">
            <label for="note">Note</label>
            <textarea id="note" name="note" rows="10" placeholder="Write your notes..."></textarea>
            <small id="noteStatus" class="hint"></small>
            </div>

            <div class="actions">
            <button type="submit" class="btn modal_btn">Save</button>
            <button type="button" id="resetForm" class="btn modal_btn">Reset</button>
            </div>
        </form>

        <!-- RIGHT: cover preview mini-card -->
        <aside class="cover_card" aria-label="Book cover preview">
            <div class="cover_img_wrap">
            <img id="coverImg" src="" alt="Book cover preview" />
            </div>
            <p id="coverCaption" class="cover_caption">Cover preview</p>
        </aside>

        </div>
    </div>

    <p class="page_hint is-warning">*please fill in the required fields!*</p>
    </div>

    <%- include('partials/footer.ejs'); -%>
    <% if (message) { %>
        <div id="toast" class="toast">
            <%= message %>
        </div>
    <% } %>
</body>
</html>

<script>
    const isbnIn = document.querySelector("#isbn");
    const isbnMessage = document.querySelector("#isbnStatus");
    const ratingMessage = document.querySelector('#ratingStatus');
    const noteMessage = document.querySelector('#noteStatus');
    const ratingInput = document.querySelector('#rating');
    const noteInput = document.querySelector('#note');
    const title = document.querySelector("#bookTitle");
    const coverImg = document.querySelector("#coverImg");
    const form = document.querySelector('.creation_form');
    coverImg.onload = () => {
    coverImg.style.display = "block";
    };
    coverImg.onerror = () => {
    coverImg.style.display = "none";
    isbnMessage.textContent = "No cover found.";
    };
    let lastISBNIn = "";

    form.addEventListener('submit',(e) =>{
        e.preventDefault();
        isbnMessage.textContent = "";
        ratingMessage.textContent = "";
        noteMessage.textContent = "";
        let error = false;

        const cleanISBN = normalizeISBN(isbnIn.value);
        const ratingVal = Number(ratingInput.value);
        const noteVal = noteInput.value.trim();

        if (!(cleanISBN.length === 10 || cleanISBN.length === 13)) {
            isbnMessage.textContent = "ISBN must be 10 or 13 digits.";
            isbnIn.focus();
            error = true;
        }

        // Rating
        if (!Number.isInteger(ratingVal) || ratingVal < 1 || ratingVal > 10) {
            ratingMessage.textContent = "Rating must be an integer between 1 and 10.";
            ratingInput.focus();
            error = true;
        }

        // Note
        if (!noteVal) {
            noteMessage.textContent = "Please write a note.";
            noteInput.focus();
            error = true;
        }

        if(error){
            return;
        }

        isbnIn.value = cleanISBN; // normalize before sending
        form.submit();
    });

    const updateDebounceReq = debounce( async (isbn)=>{
        try {
            const res = await fetch ('/isbnCheck',{
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    isbn : isbn
                })
            })
            const data = await res.json();
            if (!data.success){
                isbnMessage.textContent = data.message;
                return;
            }
            if (isbn === normalizeISBN(isbnIn.value)){
                isbnMessage.textContent = "loading complete!"
            }
            title.value = data.title;
            document.querySelector('#bookTitleHidden').value = data.title; 
            coverImg.src = data.coverURL;
        } catch (error) {
            console.log(error);
            isbnMessage.textContent = "try again later."
        }
    })
    isbnIn.addEventListener("input", (e) =>{
        isbnMessage.textContent = "";
        const clean = normalizeISBN(e.target.value);
        let len = clean.length;
        if ((len === 10 || len === 13)) {
            if(clean !== lastISBNIn){
                lastISBNIn = clean;
                isbnMessage.textContent = "loading...";
                updateDebounceReq(clean);
            }
            else{
                isbnMessage.textContent = "same isbn... no new requests"
            }
        }
        else{
            if(len>0 && len<13){
                isbnMessage.textContent = "keep typing..."
            }
            if(len>13){
                isbnMessage.textContent = "too long!!!"
            }
        }
    })
    function debounce(cb, delay=1000){
        let timeout;

        return(...args) =>{
            clearTimeout(timeout);
            timeout = setTimeout( () => {
                cb(...args)
            },
            delay)
        }
    }
    function normalizeISBN(input) {
        if (!input) return "";

        return input
            .toUpperCase()        // allow lowercase x → X
            .replace(/[^0-9X]/g, ""); // remove spaces, hyphens, etc.
    }
</script>